<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
   <left>
      <AnchorPane prefHeight="598.0" prefWidth="705.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="500.0" fitWidth="813.0" layoutX="-47.0">
               <image>
                  <Image url="@login_bg.jpg" />
               </image>
            </ImageView>
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#000000bd" height="500.0" stroke="TRANSPARENT" strokeType="INSIDE" strokeWidth="0.0" width="769.0" />
            
            <!-- Login Container -->
            <AnchorPane fx:id="login_container" layoutX="503.0" layoutY="29.0" prefHeight="439.0" prefWidth="367.0">
               <children>
                  <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="440.0" stroke="WHITE" strokeType="INSIDE" width="368.0" />
                  <AnchorPane layoutX="1.0" layoutY="70.0" prefHeight="40.0" prefWidth="366.0">
                     <children>
                        <Text fx:id="admin_panel_text" layoutX="120.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Admin Panel" />
                     </children>
                  </AnchorPane>
                  
<TextField fx:id="usernameField" layoutX="16.0" layoutY="179.0" prefHeight="26.0" prefWidth="341.0" promptText="Username(id)" styleClass="input-field" />
<PasswordField fx:id="passwordField" layoutX="16.0" layoutY="224.0" prefHeight="26.0" prefWidth="341.0" promptText="Password" styleClass="input-field" />
<Button fx:id="btn_login" layoutX="100.0" layoutY="328.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" styleClass="login-button" text="LOG IN" onAction="#handleLoginButtonClick" />

                  
                  <Text fx:id="forget_pass" layoutX="26.0" layoutY="265.0" onMouseClicked="#showForgetPasswordPane" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="forget-password-text" text="Forget password ?" wrappingWidth="200" />
               </children>
            </AnchorPane>

            <!-- Forget Password Container -->
            <AnchorPane fx:id="forget_password_container" layoutX="503.0" layoutY="29.0" prefHeight="439.0" prefWidth="367.0" visible="false">
               <children>
                   <!-- add a 'back' text in the corner of this anchorpane -->
                  <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="440.0" stroke="WHITE" strokeType="INSIDE" width="368.0" />
                  <AnchorPane layoutX="1.0" layoutY="80.0" prefHeight="40.0" prefWidth="366.0">
                     <children>
                        <Text fx:id="reset_password_text" layoutY="19.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Reset Password" textAlignment="CENTER" textOrigin="CENTER" wrappingWidth="366.125" />
                     </children>
                  </AnchorPane>
                  <TextField layoutX="16.0" layoutY="179.0" prefHeight="26.0" prefWidth="341.0" promptText="Enter your email" styleClass="input-field" />
                  <Button fx:id="btn_send_email" layoutX="100.0" layoutY="328.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" styleClass="login-button" text="Send Email" />
                  <Text fx:id="back_text" layoutX="26.0" layoutY="224.0" onMouseClicked="#goBack" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="back-text" text="Back" />
               </children>
            </AnchorPane>

            <!-- Description Text -->
            <Text fx:id="desc" fill="WHITE" layoutX="27.0" layoutY="413.0" strokeType="OUTSIDE" strokeWidth="0.0" text="&quot;Moemen Haroun and Ahmed developed a car rental app that allows users to easily browse and rent vehicles, offering a seamless and convenient rental experience with flexible options and reliable service.&quot;" wrappingWidth="374.9366874694824" />
         </children>
      </AnchorPane>
   </left>
   <right>
   </right>
</BorderPane>
